---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  canonicalPath?: string;
  documentTitle?: string;
  wide?: boolean;
}

const { title, description, eyebrow, canonicalPath, documentTitle, wide = false } = Astro.props;
---

<BaseLayout title={documentTitle ?? title} description={description} canonicalPath={canonicalPath}>
  <article class:list={['content-page', 'shell', { 'content-page--wide': wide }]}>
    <header class="content-page__header">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="content-page__body">
      <slot />
    </div>
  </article>
</BaseLayout>
