---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileIntro from '../components/home/ProfileIntro.astro';
import ResearchInterests from '../components/home/ResearchInterests.astro';
import LatestWork from '../components/home/LatestWork.astro';
import LatestUpdates from '../components/home/LatestUpdates.astro';
import {
  assertUniqueProjectKeys,
  assertUniqueTranslationKeys,
  selectFeaturedProjects,
  sortUpdatesNewestFirst,
} from '../lib/content';
import { site } from '../config/site';
import { en } from '../i18n/en';
import portrait from '../assets/images/tenghao-wang-portrait.png';
import researchImage from '../assets/images/research-world-model-rabbit.png';

const projects = await getCollection('projects');
const updates = await getCollection('updates');

assertUniqueProjectKeys(projects);
assertUniqueTranslationKeys(updates, 'update');
const featuredProjects = selectFeaturedProjects(projects, 'en', 2);
const latestUpdates = sortUpdatesNewestFirst(updates, 'en').slice(0, 3);

const pageTitle = `${site.name} | Academic Portfolio`;
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: site.affiliation,
  },
  url: site.url,
  sameAs: [site.github],
  knowsAbout: ['World models', 'Multimodal learning', 'Predictive planning'],
};
---

<BaseLayout
  title={pageTitle}
  description={site.description}
  canonicalPath="/"
  jsonLd={personJsonLd}
>
  <ProfileIntro identity={site} copy={en.profile} portrait={portrait} />
  <ResearchInterests copy={en.research} image={researchImage} />
  <LatestWork
    projects={featuredProjects}
    eyebrow={en.work.eyebrow}
    title={en.work.title}
    allProjectsLabel={en.work.allProjects}
    codeLabel={en.links.code}
  />
  {
    latestUpdates.length > 0 && (
      <LatestUpdates
        updates={latestUpdates}
        eyebrow={en.updates.eyebrow}
        title={en.updates.title}
        allUpdatesLabel={en.updates.allUpdates}
      />
    )
  }
</BaseLayout>
