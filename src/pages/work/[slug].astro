---
import { getCollection, render } from 'astro:content';
import { site } from '../../config/site';
import { en } from '../../i18n/en';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { assertUniqueProjectKeys } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  assertUniqueProjectKeys(projects);

  return projects
    .filter((entry) => entry.data.lang === 'en')
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  documentTitle={`${entry.data.title} | ${site.name}`}
  description={entry.data.summary}
  canonicalPath={`/work/${entry.data.slug}/`}
>
  <dl class="content-page__meta">
    <div>
      <dt>{en.metadata.year}</dt>
      <dd>{entry.data.year}</dd>
    </div>
    <div>
      <dt>{en.metadata.role}</dt>
      <dd>{entry.data.role}</dd>
    </div>
    <div>
      <dt>{en.metadata.topics}</dt>
      <dd>{entry.data.topics.join(', ')}</dd>
    </div>
    <div>
      <dt>{en.metadata.stage}</dt>
      <dd>{entry.data.stage}</dd>
    </div>
  </dl>
  {entry.data.links.code && <p><a href={entry.data.links.code}>{en.links.code}</a></p>}
  <Content />
</ContentLayout>

<style>
  .content-page__meta {
    display: grid;
    margin: 0 0 3rem;
    border-top: 1px solid var(--color-text);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .content-page__meta div {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .content-page__meta dt {
    margin-block-end: 0.3rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 650;
    text-transform: uppercase;
  }

  .content-page__meta dd {
    margin: 0;
  }

  @media (max-width: 48rem) {
    .content-page__meta {
      grid-template-columns: 1fr;
    }
  }
</style>
