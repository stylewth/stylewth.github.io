---
import { getCollection } from 'astro:content';
import ProjectRow from '../../components/content/ProjectRow.astro';
import { site } from '../../config/site';
import { en } from '../../i18n/en';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { assertUniqueProjectKeys, sortProjectsForArchive } from '../../lib/content';

const projects = await getCollection('projects');
assertUniqueProjectKeys(projects);

const publishedProjects = sortProjectsForArchive(projects, 'en');
---

<ContentLayout
  title="Work"
  documentTitle={`Work | ${site.name}`}
  description="Research and engineering projects by Tenghao Wang."
  canonicalPath="/work/"
  wide
>
  <div class="project-list">
    {publishedProjects.map((project) => <ProjectRow project={project.data} headingLevel={2} codeLabel={en.links.code} />)}
  </div>
</ContentLayout>

<style>
  .project-list {
    border-top: 1px solid var(--color-text);
  }
</style>
