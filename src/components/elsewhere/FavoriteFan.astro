---
import {
  favoriteCreatorLabel,
  getFavoriteFanPosition,
  type FavoriteCardModel,
  type FavoriteKind,
} from '../../lib/favorites';

interface Props {
  favorites: FavoriteCardModel[];
  kind: FavoriteKind;
  title: string;
}

const { favorites, kind, title } = Astro.props;
const creatorLabel = favoriteCreatorLabel(kind);
const panelId = `favorite-panel-${kind}`;
const tabId = `favorite-tab-${kind}`;
---

<section
  class="favorite-panel"
  id={panelId}
  role="tabpanel"
  aria-labelledby={tabId}
  data-favorite-panel={kind}
>
  <h3>{title}</h3>
  <div class="favorite-fan__viewport">
    <ol class="favorite-fan" data-favorite-list={kind}>
      {
        favorites.map((favorite) => {
          const entry = favorite.entry;
          const position = getFavoriteFanPosition(entry.data.rank);
          const rank = String(entry.data.rank).padStart(2, '0');
          const accessibleName = `${rank}. ${entry.data.title}, ${entry.data.year}, ${creatorLabel}: ${entry.data.creator}`;
          const style = [
            `--fan-x:${position.xRem}rem`,
            `--fan-y:${position.yRem}rem`,
            `--fan-rotation:${position.rotationDeg}deg`,
            `--fan-z:${position.zIndex}`,
          ].join(';');

          return (
            <li class="favorite-card" style={style}>
              <button
                type="button"
                class="favorite-card__trigger"
                disabled
                aria-label={accessibleName}
                data-favorite-trigger
                data-favorite-kind={kind}
                data-favorite-rank={entry.data.rank}
                data-favorite-title={entry.data.title}
                data-favorite-original-title={entry.data.originalTitle}
                data-favorite-year={entry.data.year}
                data-favorite-creator={entry.data.creator}
                data-favorite-creator-label={creatorLabel}
                data-favorite-review={entry.data.review}
                data-favorite-provider={favorite.provider}
                data-favorite-provider-label={favorite.providerLabel}
                data-favorite-source={favorite.sourceUrl}
              >
                <img
                  src={favorite.imageSrc}
                  srcset={favorite.imageSrcset}
                  sizes="(max-width: 48rem) 8.5rem, 9.25rem"
                  width={favorite.imageWidth}
                  height={favorite.imageHeight}
                  alt={entry.data.coverAlt}
                  loading="lazy"
                  referrerpolicy="no-referrer"
                />
                <span class="favorite-card__foot">
                  <span class="favorite-card__rank" aria-hidden="true">{rank}</span>
                  <span>{entry.data.year}</span>
                  <span aria-hidden="true">·</span>
                  <span>{entry.data.creator}</span>
                </span>
              </button>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .favorite-panel h3 {
    margin-block-end: 1.5rem;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .favorite-fan {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .favorite-card__trigger {
    position: relative;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    color: var(--color-text);
    font: inherit;
    text-align: left;
    cursor: default;
    opacity: 1;
  }

  .favorite-card__trigger :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: contain;
    background: var(--color-paper);
  }

  .favorite-card__trigger[data-favorite-kind='album'] :global(img) {
    aspect-ratio: 1;
  }

  .favorite-card__rank {
    color: var(--favorite-accent);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .favorite-card__foot {
    box-sizing: border-box;
    display: flex;
    gap: 0.38rem;
    height: 5.6rem;
    align-items: center;
    padding: 0.8rem;
    color: var(--color-muted);
    font-size: 0.76rem;
    line-height: 1.3;
  }

  :global(favorites-stage[data-enhanced]) .favorite-panel[hidden] {
    display: none;
  }

  :global(favorites-stage[data-enhanced]) .favorite-panel h3 {
    display: none;
  }

  :global(favorites-stage[data-enhanced]) .favorite-card__trigger {
    --favorite-lift: 0rem;
    --favorite-scale: 1;
    --favorite-visual-rotation: var(--fan-rotation);
    cursor: pointer;
    transform:
      translate3d(0, var(--favorite-lift), 0)
      rotate(calc(var(--favorite-visual-rotation) - var(--fan-rotation)))
      scale(var(--favorite-scale));
    transform-origin: 50% 85%;
    transition:
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 180ms ease,
      box-shadow 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(favorites-stage[data-enhanced]) .favorite-card__trigger:focus-visible {
    outline: 2px solid var(--favorite-accent);
    outline-offset: -3px;
  }

  :global(favorites-stage[data-enhanced]) .favorite-fan__viewport {
    overflow-x: auto;
    overflow-y: clip;
    padding: 2.5rem max(1rem, calc((100% - 46rem) / 2)) 1rem;
  }

  :global(favorites-stage[data-enhanced]) .favorite-fan {
    position: relative;
    display: block;
    width: 46rem;
    height: 31rem;
    margin-inline: auto;
  }

  :global(favorites-stage[data-enhanced]) .favorite-card {
    position: absolute;
    left: 50%;
    bottom: 3.5rem;
    z-index: var(--fan-z);
    width: 9.25rem;
    transform:
      translate3d(calc(-50% + var(--fan-x)), var(--fan-y), 0)
      rotate(var(--fan-rotation));
    transform-origin: 50% 145%;
  }

  :global(favorites-stage[data-enhanced]) .favorite-card:hover {
    z-index: 30;
  }

  :global(favorites-stage[data-enhanced]) .favorite-card:hover .favorite-card__trigger {
    --favorite-lift: -0.7rem;
    --favorite-scale: 1.018;
    --favorite-visual-rotation: calc(var(--fan-rotation) * 0.18);
    border-color: var(--favorite-accent);
    box-shadow:
      0 1.1rem 1.8rem rgb(16 17 15 / 0.18),
      0 0.22rem 0.55rem rgb(16 17 15 / 0.12);
  }

  :global(favorites-stage[data-enhanced]) .favorite-card:active .favorite-card__trigger {
    --favorite-lift: -0.32rem;
    --favorite-scale: 0.995;
    box-shadow:
      0 0.55rem 0.9rem rgb(16 17 15 / 0.14),
      0 0.12rem 0.28rem rgb(16 17 15 / 0.10);
  }

  @media (max-width: 48rem) {
    .favorite-fan {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    :global(favorites-stage[data-enhanced]) .favorite-fan__viewport {
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(favorites-stage[data-enhanced]) .favorite-card__trigger {
      transition: none;
    }

    :global(favorites-stage[data-enhanced]) .favorite-card:hover .favorite-card__trigger,
    :global(favorites-stage[data-enhanced]) .favorite-card:active .favorite-card__trigger {
      transform: none;
    }
  }
</style>
