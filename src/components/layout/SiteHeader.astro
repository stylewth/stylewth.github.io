---
import { en } from '../../i18n/en';
import { site } from '../../config/site';

const currentPath = Astro.url.pathname;
interface Props {
  photography?: boolean;
}

const { photography = false } = Astro.props;
const isCurrent = (path: string) =>
  path === '/' ? currentPath === path : currentPath.startsWith(path);
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="site-name" href="/" aria-label={`${site.name}, home`}>{site.name}</a>
    <nav class:list={['site-nav', { 'site-nav--desktop': photography }]} aria-label="Primary">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>{en.navigation.home}</a>
      <a href="/work/" aria-current={isCurrent('/work/') ? 'page' : undefined}>{en.navigation.work}</a>
      <a href="/updates/" aria-current={isCurrent('/updates/') ? 'page' : undefined}>{en.navigation.updates}</a>
      <a href="/elsewhere/" aria-current={isCurrent('/elsewhere/') ? 'page' : undefined}>{en.navigation.elsewhere}</a>
      <a href="/photos/" aria-current={isCurrent('/photos/') ? 'page' : undefined}>{en.navigation.photos}</a>
    </nav>
    {photography && (
      <details class="site-menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>{en.navigation.home}</a>
          <a href="/work/" aria-current={isCurrent('/work/') ? 'page' : undefined}>{en.navigation.work}</a>
          <a href="/updates/" aria-current={isCurrent('/updates/') ? 'page' : undefined}>{en.navigation.updates}</a>
          <a href="/elsewhere/" aria-current={isCurrent('/elsewhere/') ? 'page' : undefined}>{en.navigation.elsewhere}</a>
          <a href="/photos/" aria-current={isCurrent('/photos/') ? 'page' : undefined}>{en.navigation.photos}</a>
        </nav>
      </details>
    )}
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-paper);
  }

  .site-header__inner {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-header__inner:has(.site-nav--desktop) {
    width: min(calc(100% - (2 * var(--space-page))), 80rem);
  }

  .site-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 550;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.92rem;
  }

  .site-nav a {
    text-decoration: none;
  }

  .site-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.35rem;
  }

  .site-nav a[aria-current='page'] {
    font-weight: 700;
  }

  .site-menu { display: none; }

  .site-menu summary {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .site-menu summary::-webkit-details-marker { display: none; }

  .site-menu nav {
    position: absolute;
    z-index: 2;
    inset: calc(100% - 0.5rem) var(--space-page) auto;
    display: grid;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
  }

  .site-menu nav a { padding-block: 0.55rem; text-decoration: none; }

  @media (max-width: 48rem) {
    .site-header__inner:has(.site-nav--desktop) {
      position: relative;
      min-height: 4.1rem;
      align-items: center;
      flex-direction: row;
      gap: 1rem;
      padding-block: 0;
    }

    .site-nav--desktop { display: none; }

    .site-menu { display: block; font-size: 0.92rem; }

    .site-header__inner {
      min-height: auto;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.85rem;
      padding-block: 1rem;
    }

    .site-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
    }
  }

  @media (max-width: 24rem) {
    .site-nav {
      gap: 0.375rem;
      font-size: 0.86rem;
    }
  }
</style>
