---
import { site } from '../../config/site';

const year = new Date().getFullYear();
interface Props {
  photography?: boolean;
}

const { photography = false } = Astro.props;
---

<footer class:list={['site-footer', { 'site-footer--photography': photography }]}>
  <div class="site-footer__inner shell">
    <span>© {year} {site.name}</span>
    <span>{site.location}</span>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={site.github} rel="me">GitHub</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-text);
    background: var(--color-bone);
  }

  .site-footer--photography {
    border-top-color: var(--color-rule);
    background: var(--color-paper);
  }

  .site-footer__inner {
    display: grid;
    padding-block: 2.25rem;
    grid-template-columns: 1fr auto auto auto;
    gap: 2rem;
    font-size: 0.86rem;
  }

  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
