---
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ResearchRabbitState from './ResearchRabbitState.astro';

interface ResearchCopy {
  eyebrow: string;
  statement: string;
  description: string;
  interests: readonly string[];
  interestsLabel: string;
}

interface Props {
  copy: ResearchCopy;
  baseImage: ImageMetadata;
  subjectImage: ImageMetadata;
  paneImages: readonly [ImageMetadata, ImageMetadata, ImageMetadata];
}

const { copy, baseImage, subjectImage, paneImages } = Astro.props;
const paneNames = ['one', 'two', 'three'] as const;
const gates = [
  { name: paneNames[0], previous: 'observation', next: 'surface', rearZ: 3, refractionZ: 4, frontZ: 5, emergedZ: 6 },
  { name: paneNames[1], previous: 'surface', next: 'aligned', rearZ: 7, refractionZ: 8, frontZ: 9, emergedZ: 10 },
  { name: paneNames[2], previous: 'aligned', next: 'point-cloud', rearZ: 11, refractionZ: 12, frontZ: 13, emergedZ: 14 },
] as const;
const subjectMask = await getImage({ src: subjectImage, width: 320, format: 'png' });
---

<research-traversal class="research-traversal" data-research-traversal>
  <section id="research-interests" class="research-field" aria-labelledby="research-interests-title">
    <div class="research-field__content shell">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="research-interests-title" class="research-field__statement">{copy.statement}</h2>
      <p class="research-field__description">{copy.description}</p>
      <ul class="interest-list" aria-label={copy.interestsLabel}>
        {copy.interests.map((interest) => <li>{interest}</li>)}
      </ul>
    </div>

    <div class="research-field__scene" aria-hidden="true">
      <div class="research-field__base" data-research-base>
        <Picture
          src={baseImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          alt=""
          loading="lazy"
        />
      </div>

      <div class="research-field__aperture-layer research-field__static-subject" data-research-static-subject>
        <div class="research-field__travel-track research-field__travel-track--static">
          <div class="research-field__rabbit">
            <ResearchRabbitState
              state="aligned"
              subjectImage={subjectImage}
              subjectMaskUrl={subjectMask.src}
            />
          </div>
        </div>
      </div>

      <div
        class="research-field__aperture-layer research-field__subject-layer"
        data-research-dynamic
        data-research-subject
      >
        <div class="research-field__travel-track">
          <div class="research-field__rabbit" data-research-rabbit>
            <ResearchRabbitState
              state="observation"
              subjectImage={subjectImage}
              subjectMaskUrl={subjectMask.src}
            />
          </div>
        </div>
      </div>

      {gates.map(({ name, previous, next, rearZ, refractionZ, frontZ, emergedZ }, index) => (
        <div class={`research-field__gate research-field__gate--${name}`} data-research-gate>
          <div
            class={`research-field__pane research-field__pane--${name} research-field__pane--rear`}
            data-research-dynamic
            data-research-pane-rear
            style={`z-index: ${rearZ};`}
          >
            <Picture
              src={paneImages[index]}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              widths={[96, 160]}
              sizes="10vw"
              alt=""
              loading="lazy"
            />
          </div>

          <div
            class="research-field__aperture-layer research-field__refraction"
            data-research-dynamic
            data-research-refraction
            style={`z-index: ${refractionZ};`}
          >
            <div class={`research-field__scene-region research-field__scene-region--pane-${name}`}>
              <div class="research-field__travel-track research-field__travel-track--refracted">
                <div class="research-field__rabbit">
                  <ResearchRabbitState
                    class="research-field__refraction-state research-field__refraction-state--previous"
                    state={previous}
                    subjectImage={subjectImage}
                    subjectMaskUrl={subjectMask.src}
                  />
                  <ResearchRabbitState
                    class="research-field__refraction-state research-field__refraction-state--next"
                    state={next}
                    subjectImage={subjectImage}
                    subjectMaskUrl={subjectMask.src}
                  />
                </div>
              </div>
            </div>
          </div>

          <div
            class={`research-field__pane research-field__pane--${name} research-field__pane--front`}
            data-research-dynamic
            data-research-pane-front
            style={`z-index: ${frontZ};`}
          >
            <Picture
              src={paneImages[index]}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              widths={[96, 160]}
              sizes="10vw"
              alt=""
              loading="lazy"
            />
          </div>

          <div
            class="research-field__aperture-layer research-field__emerged"
            data-research-dynamic
            data-research-emerged
            style={`z-index: ${emergedZ};`}
          >
            <div class={`research-field__scene-region research-field__scene-region--after-${name}`}>
              <div class="research-field__travel-track">
                <div class="research-field__rabbit">
                  <ResearchRabbitState
                    state={next}
                    subjectImage={subjectImage}
                    subjectMaskUrl={subjectMask.src}
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</research-traversal>

<script>
  import '../../scripts/research-traversal';
</script>

<style>
  .research-traversal { --research-progress: 70%; display: block; }
  .research-field { position: relative; overflow: hidden; min-height: 42rem; background: var(--color-bone); isolation: isolate; }
  .research-field__scene { position: absolute; inset: 0; z-index: 0; }
  .research-field__scene :global(picture), .research-field__scene :global(img) { display: block; }
  .research-field__base { position: absolute; inset: 0; width: 100%; height: 100%; }
  .research-field__base :global(picture), .research-field__base :global(img) { width: 100%; height: 100%; }
  .research-field__base :global(img) { object-fit: cover; object-position: center; }
  .research-field__aperture-layer { position: absolute; inset: 0; clip-path: ellipse(18% 46% at 72% 49%); overflow: hidden; }
  .research-field__static-subject { z-index: 2; }
  .research-field__subject-layer { z-index: 2; }
  .research-field__travel-track { position: absolute; top: 46%; left: 60%; width: 27%; height: 20%; }
  .research-field__travel-track--static { --research-progress: 70%; }
  .research-field__rabbit { position: absolute; top: 50%; left: var(--research-progress); width: clamp(10rem, 17vw, 15rem); aspect-ratio: 3 / 2; transform: translate(-50%, -50%); }
  .research-field__gate { display: contents; }
  .research-field__scene-region { position: absolute; inset: 0; overflow: hidden; }
  .research-field__pane { position: absolute; top: 24%; width: 7%; height: 52%; }
  .research-field__pane--one { left: 66%; }
  .research-field__pane--two { left: 73%; }
  .research-field__pane--three { left: 80%; }
  .research-field__pane--rear { opacity: 0.24; }
  .research-field__refraction { pointer-events: none; }
  .research-field__pane--front { opacity: 0.48; }
  .research-field__emerged { pointer-events: none; }
  .research-field__pane :global(picture), .research-field__pane :global(img) { width: 100%; height: 100%; }
  .research-field__pane :global(img) { object-fit: fill; }
  .research-field__scene-region--pane-one { clip-path: inset(24% 27% 24% 66%); }
  .research-field__scene-region--pane-two { clip-path: inset(24% 20% 24% 73%); }
  .research-field__scene-region--pane-three { clip-path: inset(24% 13% 24% 80%); }
  .research-field__scene-region--after-one { clip-path: inset(0 0 0 73%); }
  .research-field__scene-region--after-two { clip-path: inset(0 0 0 80%); }
  .research-field__scene-region--after-three { clip-path: inset(0 0 0 87%); }
  .research-field__travel-track--refracted .research-field__rabbit { opacity: 0.88; transform: translate(calc(-50% + 7px), -50%) scaleX(.88); }
  :global(.research-field__refraction-state--previous) { clip-path: inset(0 45% 0 0); opacity: 0.78; }
  :global(.research-field__refraction-state--next) { clip-path: inset(0 0 0 45%); opacity: 0.84; }
  .research-traversal[data-traversal-ready] .research-field__static-subject { visibility: hidden; }
  .research-traversal:not([data-traversal-ready]) [data-research-dynamic] { visibility: hidden; }
  .research-field__content { position: relative; z-index: 15; display: flex; min-height: 42rem; flex-direction: column; justify-content: center; padding-block: var(--space-section); }
  .research-field__statement { max-width: 11ch; margin-block-end: 2rem; font-size: clamp(2.6rem, 6.1vw, 5.5rem); }
  .research-field__description { max-width: 46ch; margin-block-end: 3rem; }
  .interest-list { display: grid; max-width: 50rem; margin: 0; padding: 0; border-top: 1px solid var(--color-text); grid-template-columns: repeat(3, 1fr); list-style: none; }
  .interest-list li { padding: 1rem 1rem 1rem 0; border-bottom: 1px solid var(--color-text); font-size: 0.88rem; font-weight: 600; }

  @media (max-width: 48rem) {
    .research-field { display: grid; min-height: 0; }
    .research-field__content { order: 1; min-height: 0; padding-block: var(--space-section); }
    .research-field__scene { position: relative; inset: auto; order: 2; min-height: 24rem; }
    .research-field__base :global(img) { object-position: 70% center; }
    .research-field__aperture-layer { clip-path: ellipse(26.5% 32% at 73% 49%); }
    .research-field__travel-track { top: 46%; left: 48%; width: 42%; height: 20%; }
    .research-field__rabbit { width: 8.5rem; }
    .research-field__pane { top: 22%; width: 10%; height: 56%; }
    .research-field__pane--one { left: 54%; }
    .research-field__pane--two { left: 66%; }
    .research-field__pane--three { left: 78%; }
    .research-field__scene-region--pane-one { clip-path: inset(22% 36% 22% 54%); }
    .research-field__scene-region--pane-two { clip-path: inset(22% 24% 22% 66%); }
    .research-field__scene-region--pane-three { clip-path: inset(22% 12% 22% 78%); }
    .research-field__scene-region--after-one { clip-path: inset(0 0 0 64%); }
    .research-field__scene-region--after-two { clip-path: inset(0 0 0 76%); }
    .research-field__scene-region--after-three { clip-path: inset(0 0 0 88%); }
    .research-field__travel-track--refracted .research-field__rabbit { transform: translate(calc(-50% + 4px), -50%) scaleX(.9); }
    .interest-list { grid-template-columns: 1fr; }
  }
</style>
