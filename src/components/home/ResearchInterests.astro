---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  copy: {
    eyebrow: string;
    statement: string;
    description: string;
    interests: readonly string[];
    interestsLabel: string;
  };
  image: ImageMetadata;
}

const { copy, image } = Astro.props;
---

<section
  id="research-interests"
  class="research-field"
  aria-labelledby="research-interests-title"
>
  <div class="research-field__image" data-rabbit-field aria-hidden="true">
    <Picture
      src={image}
      formats={['avif', 'webp']}
      fallbackFormat="png"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      alt=""
      loading="lazy"
    />
  </div>
  <div class="research-field__content shell">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="research-interests-title" class="research-field__statement">
      {copy.statement}
    </h2>
    <p class="research-field__description">{copy.description}</p>
    <ul class="interest-list" aria-label={copy.interestsLabel}>
      {copy.interests.map((interest) => <li>{interest}</li>)}
    </ul>
  </div>
</section>

<style>
  .research-field {
    position: relative;
    overflow: hidden;
    min-height: 42rem;
    background: var(--color-bone);
  }

  .research-field__image {
    position: absolute;
    inset: 0;
    opacity: 0.34;
  }

  .research-field__image :global(picture),
  .research-field__image :global(img) {
    width: 100%;
    height: 100%;
  }

  .research-field__image :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .research-field__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 42rem;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-section);
  }

  .research-field__statement {
    max-width: 13ch;
    margin-block-end: 2rem;
    font-size: clamp(2.6rem, 6.4vw, 5.8rem);
  }

  .research-field__description {
    max-width: 50ch;
    margin-block-end: 3rem;
  }

  .interest-list {
    display: grid;
    max-width: 50rem;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-text);
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
  }

  .interest-list li {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--color-text);
    font-size: 0.88rem;
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .research-field,
    .research-field__content {
      min-height: 38rem;
    }

    .interest-list {
      grid-template-columns: 1fr;
    }
  }
</style>
