---
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ResearchRabbitState from './ResearchRabbitState.astro';
import { aperturePath, paneImageStyle, rabbitTrack, sceneBox, scenePanes, sceneRegion, sceneSize } from '../../lib/research-scene';

interface ResearchCopy {
  eyebrow: string;
  statement: string;
  description: string;
  interests: readonly string[];
  interestsLabel: string;
}

interface Props {
  copy: ResearchCopy;
  baseImage: ImageMetadata;
  subjectImage: ImageMetadata;
  representationImage: ImageMetadata;
  pointCloudImage: ImageMetadata;
  paneImages: readonly [ImageMetadata, ImageMetadata, ImageMetadata];
}

const { copy, baseImage, subjectImage, representationImage, pointCloudImage, paneImages } = Astro.props;
const paneNames = ['one', 'two', 'three'] as const;
const gates = [
  { name: paneNames[0], previous: 'observation', next: 'surface', rearZ: 3, underZ: 4, frontZ: 5, overZ: 6, emergedZ: 7 },
  { name: paneNames[1], previous: 'surface', next: 'aligned', rearZ: 8, underZ: 9, frontZ: 10, overZ: 11, emergedZ: 12 },
  { name: paneNames[2], previous: 'aligned', next: 'point-cloud', rearZ: 13, underZ: 14, frontZ: 15, overZ: 16, emergedZ: 17 },
] as const;
const subjectMask = await getImage({ src: subjectImage, width: 320, format: 'png' });
const trackBox = sceneBox({ x: rabbitTrack.start, y: rabbitTrack.centerY, width: rabbitTrack.end - rabbitTrack.start, height: 0 });
const rabbitSize = `${rabbitTrack.width / (rabbitTrack.end - rabbitTrack.start) * 100}%`;
---

<research-traversal class="research-traversal" data-research-traversal>
  <section id="research-interests" class="research-field" aria-labelledby="research-interests-title">
    <div class="research-field__content shell">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="research-interests-title" class="research-field__statement">{copy.statement}</h2>
      <p class="research-field__description">{copy.description}</p>
      <ul class="interest-list" aria-label={copy.interestsLabel}>
        {copy.interests.map((interest) => <li>{interest}</li>)}
      </ul>
    </div>

    <div class="research-field__scene" aria-hidden="true" data-research-stage>
      <svg class="research-field__clip-definitions" width="0" height="0" focusable="false">
        <defs>
          <clipPath id="research-aperture" clipPathUnits="objectBoundingBox">
            <path d={aperturePath} />
          </clipPath>
        </defs>
      </svg>
      <div class="research-field__canvas" style={`--rabbit-width: ${rabbitSize};`} data-research-canvas>
      <div class="research-field__base" data-research-base>
        <Picture
          src={baseImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[768, 1280, 1920]}
          sizes="(max-width: 30rem) 30rem, 100vw"
          alt=""
          loading="lazy"
        />
      </div>

      <div class="research-field__aperture-layer research-field__static-subject" data-research-static-subject>
        <div class="research-field__travel-track research-field__travel-track--static" style={trackBox}>
          <div class="research-field__rabbit">
            <ResearchRabbitState
              state="aligned"
              subjectImage={subjectImage}
              representationImage={representationImage}
              pointCloudImage={pointCloudImage}
              subjectMaskUrl={subjectMask.src}
            />
          </div>
        </div>
      </div>

      <div
        class="research-field__aperture-layer research-field__subject-layer"
        data-research-dynamic
        data-research-subject
      >
        <div class="research-field__scene-region" style={sceneRegion(0, scenePanes[0].x)}>
          <div class="research-field__travel-track" style={trackBox}>
            <div class="research-field__rabbit" data-research-rabbit>
              <ResearchRabbitState
                state="observation"
                subjectImage={subjectImage}
                representationImage={representationImage}
                pointCloudImage={pointCloudImage}
                subjectMaskUrl={subjectMask.src}
              />
            </div>
          </div>
        </div>
      </div>

      {gates.map(({ name, previous, next, rearZ, underZ, frontZ, overZ, emergedZ }, index) => {
        const pane = scenePanes[index];
        const middle = pane.x + pane.width / 2;
        return (
        <div class={`research-field__gate research-field__gate--${name}`} data-research-gate>
          <div
            class="research-field__aperture-layer research-field__pane-frame"
            data-research-dynamic
            data-research-pane-rear
            style={`z-index: ${rearZ};`}
          >
            <div class="research-field__pane research-field__pane--rear" style={sceneBox(pane)}>
              <Picture
                src={paneImages[index]}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                widths={[384, 768]}
                sizes="(max-width: 48rem) 12rem, 24rem"
                style={paneImageStyle(pane.crop)}
                alt=""
                loading="lazy"
              />
            </div>
          </div>

          {[{ half: 'in', z: underZ }, { half: 'out', z: overZ }].map(({ half, z }) => (
            <div
              class="research-field__aperture-layer research-field__refraction"
              data-research-dynamic
              data-research-refraction
              style={`z-index: ${z};`}
            >
              <div class="research-field__scene-region" style={sceneRegion(half === 'in' ? pane.x : middle, half === 'in' ? middle : pane.exit, pane.y, pane.y + pane.height)}>
                <div class="research-field__travel-track research-field__travel-track--refracted" style={trackBox}>
                  <div class="research-field__rabbit">
                    <ResearchRabbitState
                      state={half === 'in' ? previous : next}
                      subjectImage={subjectImage}
                      representationImage={representationImage}
                      pointCloudImage={pointCloudImage}
                      subjectMaskUrl={subjectMask.src}
                    />
                  </div>
                </div>
              </div>
            </div>
          ))}

          <div
            class="research-field__aperture-layer research-field__pane-frame"
            data-research-dynamic
            data-research-pane-front
            style={`z-index: ${frontZ};`}
          >
            <div class="research-field__pane research-field__pane--front" style={sceneBox(pane)}>
              <Picture
                src={paneImages[index]}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                widths={[384, 768]}
                sizes="(max-width: 48rem) 12rem, 24rem"
                style={paneImageStyle(pane.crop)}
                alt=""
                loading="lazy"
              />
            </div>
          </div>

          <div
            class="research-field__aperture-layer research-field__emerged"
            data-research-dynamic
            data-research-emerged
            style={`z-index: ${emergedZ};`}
          >
            <div class="research-field__scene-region" style={sceneRegion(pane.exit, scenePanes[index + 1]?.x ?? sceneSize.width)}>
              <div class="research-field__travel-track" style={trackBox}>
                <div class="research-field__rabbit">
                  <ResearchRabbitState
                    state={next}
                    subjectImage={subjectImage}
                    representationImage={representationImage}
                    pointCloudImage={pointCloudImage}
                    subjectMaskUrl={subjectMask.src}
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
        );
      })}
      </div>
    </div>
  </section>
</research-traversal>

<script>
  import '../../scripts/research-traversal';
</script>

<style>
  .research-traversal { --research-progress: 70%; display: block; }
  .research-field { position: relative; overflow: hidden; min-height: max(42rem, 62vw); background: var(--color-bone); isolation: isolate; }
  .research-field__scene { position: absolute; inset: 0; z-index: 0; container-type: size; overflow: hidden; }
  .research-field__clip-definitions { position: absolute; }
  /* The image and every overlay share this single, uniformly scaled source plane. */
  .research-field__canvas { position: absolute; top: 50%; left: 50%; width: max(100cqw, 150cqh); aspect-ratio: 3 / 2; transform: translate(-50%, -50%); }
  .research-field__scene :global(picture), .research-field__scene :global(img) { display: block; }
  .research-field__base { position: absolute; inset: 0; width: 100%; height: 100%; }
  .research-field__base :global(picture), .research-field__base :global(img) { width: 100%; height: 100%; }
  .research-field__base :global(img) { object-fit: fill; }
  .research-field__aperture-layer { position: absolute; inset: 0; clip-path: url(#research-aperture); overflow: hidden; }
  .research-field__static-subject { z-index: 2; }
  .research-field__subject-layer { z-index: 2; }
  /* Move the registered track without relaying out every rabbit copy on scroll. */
  .research-field__travel-track { position: absolute; transform: translateX(var(--research-progress)); }
  .research-field__travel-track--static { --research-progress: 74%; }
  .research-field__rabbit { position: absolute; top: 50%; left: 0; width: var(--rabbit-width); aspect-ratio: 3 / 2; transform: translate(-50%, -50%); }
  .research-field__gate { display: contents; }
  .research-field__scene-region { position: absolute; inset: 0; overflow: hidden; }
  .research-field__pane-frame { pointer-events: none; }
  .research-field__pane { position: absolute; overflow: hidden; }
  .research-field__pane :global(img) { position: absolute; max-width: none; object-fit: fill; }
  .research-field__pane--rear { opacity: 0.18; }
  .research-field__refraction { pointer-events: none; }
  .research-field__pane--front { opacity: 0.45; }
  .research-field__emerged { pointer-events: none; }
  .research-field__travel-track--refracted .research-field__rabbit { transform: translate(-48%, -50%) scaleX(.97); }
  .research-traversal[data-traversal-ready] .research-field__static-subject { visibility: hidden; }
  .research-traversal:not([data-traversal-ready]) [data-research-dynamic] { visibility: hidden; }
  .research-field__content { position: relative; z-index: 15; display: flex; min-height: max(42rem, 62vw); flex-direction: column; justify-content: center; padding-block: var(--space-section); }
  .research-field__statement { max-width: 11ch; margin-block-end: 2rem; font-size: clamp(2.6rem, 6.1vw, 5.5rem); }
  .research-field__description { max-width: 46ch; margin-block-end: 3rem; }
  .interest-list { display: grid; max-width: 34rem; margin: 0; padding: 0; border-top: 1px solid var(--color-text); grid-template-columns: repeat(3, 1fr); list-style: none; }
  .interest-list li { padding: 1rem 1rem 1rem 0; border-bottom: 1px solid var(--color-text); font-size: 0.88rem; font-weight: 600; }

  @media (max-width: 48rem) {
    .research-field { display: grid; min-height: 0; }
    .research-field__content { order: 1; min-height: 0; padding-block: var(--space-section); }
    .research-field__scene { position: relative; inset: auto; order: 2; height: clamp(20rem, 66.6667vw, 32rem); }
    .research-field__canvas { left: 100%; transform: translate(-100%, -50%); }
    .interest-list { grid-template-columns: 1fr; }
  }
</style>
