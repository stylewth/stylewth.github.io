---
import { Picture } from 'astro:assets';
import portrait from '../../assets/images/tenghao-wang-portrait.png';
import { site } from '../../config/site';
import { en } from '../../i18n/en';
---

<section id="profile" class="profile shell" aria-labelledby="profile-title">
  <figure class="profile__portrait">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      fallbackFormat="png"
      widths={[190, 250, 500]}
      sizes="(max-width: 48rem) 190px, 250px"
      alt="Portrait of Tenghao Wang"
      loading="eager"
      fetchpriority="high"
    />
  </figure>
  <div class="profile__copy">
    <h1 id="profile-title">{site.name}</h1>
    <p class="profile__role">{en.profile.role}</p>
    <p>{en.profile.introduction}</p>
    <p>{en.profile.currentWork}</p>
    <p class="profile__links">
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.github} rel="me">GitHub</a>
    </p>
  </div>
</section>
