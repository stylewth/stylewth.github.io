---
import UpdateList from '../content/UpdateList.astro';
import type { CollectionEntry } from 'astro:content';

type Update = CollectionEntry<'updates'>;

interface Props {
  updates: Update[];
  eyebrow: string;
  title: string;
  allUpdatesLabel: string;
}

const { updates, eyebrow, title, allUpdatesLabel } = Astro.props;
---

<section
  id="latest-updates"
  class="latest-section shell"
  aria-labelledby="latest-updates-title"
>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id="latest-updates-title" class="section-heading">{title}</h2>
  <UpdateList updates={updates.map((update) => update.data)} headingLevel={3} />
  <a class="latest-updates__archive" href="/updates/">{allUpdatesLabel}</a>
</section>

<style>
  .latest-section {
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-rule);
  }

  .latest-updates__archive {
    display: inline-block;
    margin-block-start: 1.5rem;
    font-weight: 650;
  }
</style>
