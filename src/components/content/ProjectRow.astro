---
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>['data'];

interface Props {
  project: Project;
  headingLevel: 2 | 3;
  codeLabel: string;
}

const { project, headingLevel, codeLabel } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="project-row">
  <div>
    <Heading><a href={`/work/${project.slug}/`}>{project.title}</a></Heading>
    <p>{project.summary}</p>
  </div>
  <div class="project-row__meta">
    <p class="project-row__classification"><span>{project.kind}</span><span>{project.stage}</span></p>
    <p>{project.year}</p>
    <p>{project.role}</p>
    <p>{project.topics.join(', ')}</p>
    {project.links.code && <a class="project-row__link" href={project.links.code}>{codeLabel}</a>}
  </div>
</article>

<style>
  .project-row {
    display: grid;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--color-rule);
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  .project-row :is(h2, h3) {
    margin-block-end: 0.75rem;
    font-size: clamp(1.75rem, 3vw, 2.4rem);
  }

  .project-row > div > p {
    max-width: 52ch;
    margin-block-end: 0;
    color: var(--color-muted);
  }

  .project-row__meta {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    font-size: 0.86rem;
  }

  .project-row__meta p {
    margin-block-end: 0;
    color: var(--color-text);
  }

  .project-row__meta .project-row__classification {
    display: flex;
    gap: 0.65rem;
    color: var(--color-muted);
    text-transform: lowercase;
  }

  .project-row__classification span + span::before {
    content: '·';
    margin-inline-end: 0.65rem;
  }

  .project-row__link {
    width: fit-content;
    margin-block-start: 0.35rem;
    font-weight: 650;
  }

  @media (max-width: 48rem) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
