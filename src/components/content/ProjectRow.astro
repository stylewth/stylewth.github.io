---
interface Project {
  title: string;
  slug: string;
  summary: string;
  year: number;
  role: string;
  topics: string[];
  links: {
    code?: string;
  };
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-row">
  <div>
    <h3><a href={`/work/${project.slug}/`}>{project.title}</a></h3>
    <p>{project.summary}</p>
  </div>
  <div class="project-row__meta">
    <p>{project.year}</p>
    <p>{project.role}</p>
    <p>{project.topics.join(', ')}</p>
    {project.links.code && <a class="project-row__link" href={project.links.code}>Code</a>}
  </div>
</article>
