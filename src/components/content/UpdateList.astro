---
import type { CollectionEntry } from 'astro:content';

type Update = CollectionEntry<'updates'>['data'];

interface Props {
  updates: Update[];
  headingLevel: 2 | 3;
}

const { updates, headingLevel } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ol class="update-list">
  {
    updates.map((update) => (
      <li class="update-row">
        <p class="update-row__meta"><time datetime={update.date}>{update.date}</time><span>{update.kind}</span></p>
        <Heading>
          {update.url ? <a href={update.url}>{update.title}</a> : update.title}
        </Heading>
        <p>{update.summary}</p>
      </li>
    ))
  }
</ol>

<style>
  .update-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-text);
    list-style: none;
  }

  .update-row {
    display: grid;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-rule);
    grid-template-columns: 9rem minmax(0, 0.7fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .update-row__meta,
  .update-row > p {
    color: var(--color-muted);
  }

  .update-row :is(h2, h3),
  .update-row > p {
    margin-block-end: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1.55;
  }

  .update-row :is(h2, h3) {
    font-weight: 650;
  }

  .update-row > .update-row__meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.86rem;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .update-row__meta span::before {
    content: '·';
    margin-inline-end: 0.5rem;
  }

  @media (max-width: 48rem) {
    .update-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
